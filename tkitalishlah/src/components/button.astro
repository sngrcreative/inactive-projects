---
interface Props extends astroHTML.JSX.ButtonHTMLAttributes {}

const { class: className, ...props } = Astro.props
---

<button
  class={`bg-brand-light hover:bg-brand-dark text-brand-dark hover:text-brand-light transition-colors ease-in border-brand-dark border text-4xl w-full rounded-full shadow py-2 px-8 ${className}`}
  {...props}
>
  <slot />
</button>
