---
import type { GetImageResult } from 'astro'

interface Props {
  logo: GetImageResult
}

const { logo } = Astro.props
---

<div class="flex items-center gap-1">
  <img src={logo.src} alt="" loading="eager" {...logo.attributes} />
  <h1
    class="font-heading text-4xl text-brand-light [-webkit-text-stroke:1px_var(--text-border)] max-w-[160px]"
  >
    TKIT <br /> Al-Ishlah
  </h1>
</div>

<style>
  :root {
    --text-border: theme('colors.brand.dark');
  }
</style>
